<Page x:Class="DailyReportMemoApp.Views.ProjectManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DailyReportMemoApp.Views"
      mc:Ignorable="d" 
      d:DesignHeight="810" d:DesignWidth="580"
      Title="ProjectManagementPage">
    <Grid Margin="10,0,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 案件一覧 -->
        <Border Grid.Row="0"
                BorderBrush="Gray"
                BorderThickness="1"
                Margin="0,0,0,10"
                Padding="10"
                Height="250">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="案件一覧"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10" />

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,0,10">
                    <ListBox x:Name="ProjectsListBox"
                             IsEnabled="True"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ProjectsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Projects.ProjectName}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </ScrollViewer>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="ProjectName"
                             HorizontalAlignment="Stretch"
                             Height="20"
                             TextWrapping="Wrap"
                             HorizontalScrollBarVisibility="Disabled"
                             IsEnabled="True"
                             Margin="0,0,10,0"
                             />

                    <Button Grid.Column="1"
                            Content="追加"
                            Width="Auto"
                            Height="Auto"
                            HorizontalAlignment="Center"
                            IsEnabled="True"
                            x:Name="ProjectNameBtn"
                            Click="ProjectEntry_Click"
                            />
                </Grid>
            </Grid>
        </Border>

        <!-- 案件メモ -->
        <Border Grid.Row="1"
                x:Name="ProjectReNameBorder"
                BorderBrush="Gray"
                BorderThickness="1"
                Margin="0,0,0,10"
                Padding="10"
                Height="210"
                Visibility="Collapsed"
                Opacity="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0"
                           Text="案件名"
                           FontSize="12"
                           FontWeight="Bold"
                           Margin="0" />
                
                <TextBox Grid.Row="1"
                         x:Name="ProjectReNameBox"
                         Height="28"
                         HorizontalAlignment="Stretch"
                         TextWrapping="Wrap"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalScrollBarVisibility="Auto"
                         IsEnabled="True"
                         Margin="0,0,0,10"
                         />

                <TextBlock Grid.Row="2"
                           Text="メモ："
                           FontSize="12"
                           FontWeight="Bold"
                           Margin="0" />

                <TextBox Grid.Row="3"
                         x:Name="ProjectsMemoPanel"
                         Height="88"
                         HorizontalAlignment="Stretch"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalScrollBarVisibility="Auto"
                         IsEnabled="True"
                         Margin="0,0,0,10"
                         />
                
                <Grid Grid.Row="4"
                      Height="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              x:Name="CompletedBox"
                              Content="完了" />
                    
                </Grid>
                
            </Grid>
        </Border>


        <!-- 作業一覧 -->
        <Border Grid.Row="2"
                x:Name="TaskItemsListBorder"
                BorderBrush="Gray"
                BorderThickness="1"
                Margin="0"
                Padding="10"
                Height="250"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="作業一覧"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10" />

                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Margin="0,0,0,10">

                    <ItemsControl
                        x:Name="TaskItemsListBox"
                        ItemsSource="{Binding}">
                        
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border
                                    Padding="3"
                                    Margin="0,0,0,4"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="#DDDDDD">

                                    <TextBlock
                                        Text="{Binding TaskItems.TaskItemName}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center" />

                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </ScrollViewer>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="TaskItemName"
                             Height="20"
                             TextWrapping="Wrap"
                             HorizontalAlignment="Stretch"
                             HorizontalScrollBarVisibility="Disabled"
                             IsEnabled="False"
                             Margin="0,0,10,0"
                             />

                    <Button Grid.Column="1"
                            Content="追加"
                            Width="Auto"
                            Height="Auto"
                            HorizontalAlignment="Center"
                            IsEnabled="False"
                            x:Name="TaskItemNameBtn"
                            Click="TaskItemEntry_Click"
                            />
                </Grid>
            </Grid>
        </Border>
        
        <Button Grid.Row="3"
                Content="適用"
                Width="Auto"
                Height="Auto"
                HorizontalAlignment="Right"
                Visibility="Collapsed"
                Margin="0, 20"
                x:Name="ProjectSaveBtn"
                Click="ProjectSaveBtn_Click"
                />

    </Grid>
</Page>
