<Window x:Class="DailyReportMemoApp.SpecialTasksEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DailyReportMemoApp"
        mc:Ignorable="d"
        Title="デフォルト作業設定"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource CommonWindowStyle}">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <!-- メイン画面部分 -->
            <StackPanel DockPanel.Dock="Top" Margin="20">
                <StackPanel x:Name="SpecialTasksListPanel" />

                <TextBox x:Name="SpecialTaskName"
                     Width="300"
                     Height="30"
                     Margin="0,0,0,10"
                     TextWrapping="Wrap"
                     HorizontalScrollBarVisibility="Disabled"/>

                <Button Content="追加"
                    HorizontalAlignment="Center"
                    Click="SpecialTaskEntry_Click"/>

            </StackPanel>
            <Button Content="閉じる"
                    Width="100"
                    Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="CloseSpecialTaskEntry_Click"/>
        </Grid>
    </ScrollViewer>
</Window>
