<Window x:Class="DailyReportMemoApp.WorkEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DailyReportMemoApp"
        mc:Ignorable="d"
        Title="作業記録" Height="900" Width="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource CommonWindowStyle}">
    <DockPanel>

        <!-- 上部メニュー -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="作業">
                <MenuItem Header="終了"
                          Click="WorkCompleted_Click"/>
            </MenuItem>

            <MenuItem Header="管理">
                <MenuItem Header="案件を追加"
                          Click="OpenProjectEntryWindow_Click"/>
                <MenuItem Header="デフォルト作業設定"
                          Click="OpenSpecialTasksEntryWindow_Click"/>
                <MenuItem Header="一括案件管理"
                          Click="OpenProjectManagementWindow_Click"/>
            </MenuItem>

            <MenuItem Header="表示">
                <MenuItem Header="過去作業ログ"
                          Click="OpenPastWorkLogsWindow_Click"/>
            </MenuItem>

            <MenuItem Header="ヘルプ">
                <MenuItem Header="このアプリについて"/>
            </MenuItem>
        </Menu>

        <!-- メイン画面部分 -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                    Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TodayDate"
                    Text="何月日"
                    Grid.Row="0"
                    Grid.Column="0"
                    FontSize="16"
                    FontWeight="Bold"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"/>

                <Button Grid.Row="0"
                        Grid.Column="1"
                        Content="案件を追加"
                        FontSize="16"
                        Width="Auto"
                        Height="Auto"
                        Style="{StaticResource SettingButtonStyle}"
                        Click="OpenProjectEntryWindow_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TasksListPanel" />
            </ScrollViewer>

            <Grid Grid.Row="2"
              Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="閉じる"
                    Grid.Row="0"
                    Grid.Column="0"
                    Width="100"
                    Height="35"
                    Margin="0,0,30,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="CloseButton_Click" />

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Content="本日の作業終了"
                    Width="100"
                    Height="35"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="WorkCompleted_Click"
                    />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
