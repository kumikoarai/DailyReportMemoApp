<Window x:Class="DailyReportMemoApp.Views.WorkEndConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DailyReportMemoApp.Views"
        mc:Ignorable="d"
        Title="作業終了" Height="900" Width="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource CommonWindowStyle}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
        Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TodayDate"
                Text="何月日"
                Grid.Row="0"
                Grid.Column="0"
                FontSize="16"
                FontWeight="Bold"
                Margin="0,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"/>
            <TextBlock x:Name="TodayWorkTimes"
                Text="作業終了確認"
                Grid.Row="0"
                Grid.Column="1"
                FontSize="16"
                FontWeight="Bold"
                Margin="30,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="TasksListPanel" />
        </ScrollViewer>

        <Grid Grid.Row="2"
              Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button Content="閉じる"
                Grid.Row="0"
                Grid.Column="0"
                Width="100"
                Height="35"
                Margin="0,0,30,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="CloseButton_Click" />

            <Button
                Grid.Row="0"
                Grid.Column="1"
                Content="完了"
                Width="100"
                Height="35"
                Margin="0,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="WorkCompleted_Click"
                />
        </Grid>

    </Grid>
</Window>
