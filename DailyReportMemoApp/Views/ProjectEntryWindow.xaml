<Window x:Class="DailyReportMemoApp.ProjectEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DailyReportMemoApp"
        mc:Ignorable="d"
        Title="案件追加" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource CommonWindowStyle}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 会社一覧 -->
            <Border Grid.Column="0"
            BorderBrush="Gray"
            BorderThickness="1"
            Margin="5"
            Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                       Text="会社一覧"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,10" />

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ListBox x:Name="CompaniesListBox"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="CompaniesListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CompanyName}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="CompanyName"
                                 Width="180"
                                 Height="20"
                                 TextWrapping="Wrap"
                                 HorizontalAlignment="Left"
                                 HorizontalScrollBarVisibility="Disabled"/>

                        <Button Grid.Column="1"
                                Content="追加"
                                Width="Auto"
                                Height="Auto"
                                HorizontalAlignment="Center"
                                Click="CompanyEntry_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 案件一覧 -->
            <Border Grid.Column="1"
            BorderBrush="Gray"
            BorderThickness="1"
            Margin="5"
            Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                       Text="案件一覧"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,10" />

                    <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                        <ListBox x:Name="ProjectsListBox"
                                 IsEnabled="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="ProjectsListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Projects.ProjectName}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </ScrollViewer>
                    
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="ProjectName"
                                 Width="180"
                                 Height="20"
                                 TextWrapping="Wrap"
                                 HorizontalAlignment="Left"
                                 HorizontalScrollBarVisibility="Disabled"
                                 IsEnabled="False"
                                 />

                        <Button Grid.Column="1"
                                Content="追加"
                                Width="Auto"
                                Height="Auto"
                                HorizontalAlignment="Center"
                                IsEnabled="False"
                                x:Name="ProjectNameBtn"
                                Click="ProjectEntry_Click"
                                />
                    </Grid>
                </Grid>
            </Border>

            <!-- 作業一覧 -->
            <Border Grid.Column="2"
            BorderBrush="Gray"
            BorderThickness="1"
            Margin="5"
            Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                       Text="作業一覧"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,10" />

                    <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                        <ListBox x:Name="TaskItemsListBox"
                                 IsEnabled="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TaskItems.TaskItemName}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                    
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="TaskItemName"
                                 Width="180"
                                 Height="20"
                                 TextWrapping="Wrap"
                                 HorizontalAlignment="Left"
                                 HorizontalScrollBarVisibility="Disabled"
                                 IsEnabled="False"
                                 />

                        <Button Grid.Column="1"
                                Content="追加"
                                Width="Auto"
                                Height="Auto"
                                HorizontalAlignment="Center"
                                IsEnabled="False"
                                x:Name="TaskItemNameBtn"
                                Click="TaskItemEntry_Click"
                                />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Button Grid.Row="2"
                Content="案件追加"
                Width="100"
                Height="35"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                x:Name="SelectedProjectTaskItemBtn"
                Click="SelectedProjectTaskItem_Click"
                />
    </Grid>
</Window>
