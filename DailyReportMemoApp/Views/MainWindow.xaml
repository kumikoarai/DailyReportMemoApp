<Window x:Class="DailyReportMemoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DailyReportMemoApp"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource CommonWindowStyle}">
    
    <DockPanel>

        <!-- 上部メニュー -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="作業">
                <MenuItem Header="開始"/>
                <MenuItem Header="終了"/>
            </MenuItem>

            <MenuItem Header="管理">
                <MenuItem Header="デフォルト作業設定"/>
                <MenuItem Header="一括案件管理"/>
            </MenuItem>

            <MenuItem Header="表示">
                <MenuItem Header="過去作業ログ"/>
            </MenuItem>

            <MenuItem Header="ヘルプ">
                <MenuItem Header="このアプリについて"/>
            </MenuItem>
        </Menu>

        <!-- メイン画面部分 -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Vertical"
                        Margin="0,0,0,70">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="本日も頑張ろう！"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,0,0,20"
                               HorizontalAlignment="Center"/>

                    <TextBlock Grid.Row="1"
                               x:Name="TodayDate"
                               Text=""
                               FontSize="16"
                               Margin="0,0,0,20"
                               HorizontalAlignment="Center"/>

                    <Button Grid.Row="2"
                            Content="開始"
                            Width="150"
                            Height="40"
                            HorizontalAlignment="Center"
                            Click="OpenWorkEntryWindow_Click"/>
                </Grid>
            </StackPanel>


            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                
                <Button Content="過去作業ログ"
                        FontSize="16"
                        Width="Auto"
                        Height="Auto"
                        Style="{StaticResource SettingButtonStyle}"
                        />
                
                <Button Content="デフォルト作業設定"
                        FontSize="16"
                        Width="Auto"
                        Height="Auto"
                        Margin="50,0"
                        Style="{StaticResource SettingButtonStyle}"
                        Click="OpenSpecialTasksEntryWindow_Click"
                        />
                
                <Button Content="一括案件管理"
                        FontSize="16"
                        Width="Auto"
                        Height="Auto"
                        Style="{StaticResource SettingButtonStyle}"
                        />
            </StackPanel>
        </Grid>

    </DockPanel>
</Window>
